{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content.schema.world-map.v1",
  "title": "ProjetoRPG world map",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "enabled", "displayName", "navigationId", "spawns", "walkSpeed", "agentRadius", "sourceCommit"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._][a-z0-9]+)*$" },
    "enabled": { "type": "boolean" },
    "displayName": { "type": "string", "minLength": 1 },
    "navigationId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._][a-z0-9]+)*$" },
    "spawns": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "position"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._][a-z0-9]+)*$" },
          "position": {
            "type": "object", "additionalProperties": false,
            "required": ["x", "y", "z"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            }
          }
        }
      }
    },
    "walkSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
    "agentRadius": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
