{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content.schema.world-navigation.v1",
  "title": "ProjetoRPG triangle navigation mesh",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sourceCommit", "triangles"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._][a-z0-9]+)*$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "triangles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["a", "b", "c"],
        "properties": {
          "a": { "$ref": "#/$defs/point" },
          "b": { "$ref": "#/$defs/point" },
          "c": { "$ref": "#/$defs/point" }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "number" }
    }
  }
}
